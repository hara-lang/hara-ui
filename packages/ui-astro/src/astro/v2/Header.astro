---
import HaraMark from "../HaraMark.astro";

type NavItem = {
  href: string;
  label: string;
  current?: boolean;
  external?: boolean;
};

type AccountState = "logged-in" | "logged-out";
type MenuMode = "navigation" | "product";

const {
  homeHref = "/",
  section,
  showSection = false,
  nav = [] as NavItem[],
  activePath = "",
  label = section ? `Hara ${section}` : "Hara",
  account = "logged-out" as AccountState,
  accountHref = "#account",
  accountLabel = "Sign in",
  menuMode = "navigation" as MenuMode,
  menuControls,
  menuLabel = menuMode === "product" ? "Open application menu" : "Open navigation",
  menuCloseLabel = menuMode === "product" ? "Close application menu" : "Close navigation",
  navigationId: suppliedNavigationId
} = Astro.props;

const current = (item: NavItem) => item.current ?? (
  item.href === "/" ? activePath === "/" : Boolean(activePath && activePath.startsWith(item.href))
);
const idSeed = String(section ?? label ?? "primary")
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-|-$/g, "") || "primary";
const navigationId = suppliedNavigationId ?? `hara-v2-${idSeed}-navigation`;
if (menuMode === "product" && !menuControls) {
  throw new Error("Hara Header product menu mode requires a menuControls target ID");
}
const menuControlsId = menuMode === "product" ? menuControls : navigationId;
const hasMenu = nav.length > 0 || menuMode === "product";
---
<header
  class="hara-v2-header"
  data-hara-shell-header
  data-account={account}
  data-hara-menu-mode={menuMode}
  data-navigation-open="false"
>
  <div class="hara-v2-header-row">
    <div class="hara-v2-header-left">
      {hasMenu && (
        <button
          class="hara-v2-menu-button"
          type="button"
          data-hara-header-menu
          aria-expanded="false"
          aria-controls={menuControlsId}
          aria-haspopup="true"
          aria-label={menuLabel}
          title={menuLabel}
          data-open-label={menuLabel}
          data-close-label={menuCloseLabel}
        >
          <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
        </button>
      )}
      <a
        class:list={["hara-v2-brand", showSection && "hara-v2-brand--with-section"]}
        href={homeHref}
        aria-label={label}
      >
        <HaraMark size={28} title="Hara" />
        <span class="hara-v2-wordmark">Hara</span>
        {showSection && section && <span class="hara-v2-brand-divider" aria-hidden="true">/</span>}
        {showSection && section && <span class="hara-v2-brand-section">{section}</span>}
      </a>
    </div>

    <nav class="hara-v2-ecosystem-nav" data-hara-header-navigation aria-label="Hara ecosystem navigation">
      {nav.map((item: NavItem) => (
        <a
          href={item.href}
          aria-current={current(item) ? "page" : undefined}
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noreferrer" : undefined}
        >{item.label}</a>
      ))}
    </nav>

    <div class="hara-v2-header-actions">
      <slot />
      {account === "logged-out" && (
        <a class="hara-v2-account-link" href={accountHref}>{accountLabel}</a>
      )}
    </div>
  </div>

  {menuMode === "navigation" && nav.length > 0 && (
    <div
      class="hara-v2-mobile-navigation"
      id={navigationId}
      data-hara-mobile-navigation
      aria-hidden="true"
      hidden
    >
      <nav aria-label="Hara compact navigation">
        {nav.map((item: NavItem) => (
          <a
            href={item.href}
            aria-current={current(item) ? "page" : undefined}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noreferrer" : undefined}
          >{item.label}</a>
        ))}
      </nav>
    </div>
  )}

  {menuMode === "navigation" && nav.length > 0 && (
    <noscript>
      <div class="hara-v2-mobile-navigation hara-v2-mobile-navigation--fallback">
        <nav aria-label="Hara compact navigation">
          {nav.map((item: NavItem) => (
            <a
              href={item.href}
              aria-current={current(item) ? "page" : undefined}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noreferrer" : undefined}
            >{item.label}</a>
          ))}
        </nav>
      </div>
    </noscript>
  )}
</header>
<script>
  import { initialiseHaraHeaders } from "@hara-lang/ui/v2/header.js";

  initialiseHaraHeaders();
  document.addEventListener("astro:page-load", () => initialiseHaraHeaders());
</script>
