---
interface Props {
  label?: string;
  orientation?: "horizontal" | "vertical";
  class?: string;
}

const {
  label,
  orientation = "horizontal",
  class: className = ""
} = Astro.props;
---
<div
  class:list={["hara-tool-group", className]}
  role="group"
  aria-label={label}
  data-orientation={orientation}
>
  <slot />
</div>
