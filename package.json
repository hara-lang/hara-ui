  "files": [
    "tokens.css",
    "components.css",
    "studio.css",
    "studio-shell.js",
    "spec-explorer.css",
    "spec-explorer.js",
    "menu-bar.js",
    "workspace.js",
    "workbench.js",
    "document.css",
    "document-model.js",
    "document-editor.js",
    "document-hestia.js",
    "document-compatibility.js",
