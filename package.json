{
  "name": "@hara-lang/ui",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Product-neutral browser services, primitives and compatibility UI surfaces for Hara",
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    "./tokens.css": "./tokens.css",
    "./components.css": "./components.css",
    "./studio.css": "./studio.css",
    "./studio-shell": "./studio-shell.js",
    "./spec-explorer.css": "./spec-explorer.css",
    "./spec-explorer": "./spec-explorer.js",
    "./menu-bar": "./menu-bar.js",
    "./workspace": "./workspace.js",
    "./workbench": "./workbench.js",
    "./document.css": "./document.css",
    "./document-model": "./document-model.js",
    "./document-editor": "./document-editor.js",
    "./document-hestia": "./document-hestia.js",
    "./document-compatibility": "./document-compatibility.js"
  },
  "files": [
    "tokens.css",
    "components.css",
    "studio.css",
    "studio-shell.js",
    "spec-explorer.css",
    "spec-explorer.js",
    "menu-bar.js",
    "workspace.js",
    "workbench.js",
    "document.css",
    "document-model.js",
    "document-editor.js",
    "document-hestia.js",
    "document-compatibility.js",
    "document-demo.html",
    "favicon-48.svg",
    "favicon-128.svg",
    "favicon-256.svg",
    "logo.svg",
    "logo-white.svg",
    "og-hara-ui.jpg",
    "index.html",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js && npm test --workspaces --if-present",
    "check": "node --check document-model.js && node --check document-editor.js && node --check document-hestia.js && node --check document-compatibility.js && npm run check --workspaces --if-present"
  },
  "license": "MIT"
}
