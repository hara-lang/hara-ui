    "./workspace": "./workspace.js",
    "./workbench": "./workbench.js",
    "./document.css": "./document.css",
    "./document-model": "./document-model.js",
    "./document-editor": "./document-editor.js",
    "./document-hestia": "./document-hestia.js",
    "./document-compatibility": "./document-compatibility.js",
    "./theme.css": "./foundation/theme.css",
    "./motifs.css": "./foundation/motifs.css",
    "./effects.css": "./foundation/effects.css",
    "./theme.js": "./foundation/theme.js",
    "./v2.css": "./v2.css",
