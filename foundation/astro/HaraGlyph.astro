---
import { haraGlyphDefinition } from "../icons.mjs";

interface Props {
  name: string;
  size?: number;
  label?: string;
  decorative?: boolean;
  strokeWidth?: number;
  class?: string;
}

const {
  name,
  size = 32,
  label,
  decorative = !label,
  strokeWidth = 1.6,
  class: className = ""
} = Astro.props;

const definition = haraGlyphDefinition(name);
if (!definition) throw new Error(`Unknown Hara glyph: ${name}`);
if (!decorative && !label) throw new Error(`Meaningful Hara glyph "${name}" requires a label`);
---
<svg
  class:list={["hara-glyph", className]}
  width={size}
  height={size}
  style={`width:${size}px;height:${size}px`}
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={decorative ? undefined : "img"}
  aria-hidden={decorative ? "true" : undefined}
  aria-label={decorative ? undefined : label}
  focusable="false"
  data-hara-glyph={name}
  data-category={definition.category}
>
  {definition.paths.map((d) => <path d={d} vector-effect="non-scaling-stroke" />)}
  {definition.circles.map((circle) => (
    <circle cx={circle.cx} cy={circle.cy} r={circle.r} vector-effect="non-scaling-stroke" />
  ))}
  {definition.rects.map((rect) => (
    <rect
      x={rect.x}
      y={rect.y}
      width={rect.width}
      height={rect.height}
      rx={rect.rx ?? 0}
      vector-effect="non-scaling-stroke"
    />
  ))}
  <g class="hara-glyph-signal" aria-hidden="true">
    {definition.accentPaths.map((d) => <path d={d} vector-effect="non-scaling-stroke" />)}
  </g>
</svg>
