---
import { haraIconDefinition } from "../icons.mjs";

interface Props {
  name: string;
  size?: number;
  label?: string;
  decorative?: boolean;
  strokeWidth?: number;
  class?: string;
}

const {
  name,
  size = 24,
  label,
  decorative = !label,
  strokeWidth = 1.75,
  class: className = ""
} = Astro.props;

const definition = haraIconDefinition(name);
if (!definition) throw new Error(`Unknown Hara icon: ${name}`);
if (!decorative && !label) throw new Error(`Meaningful Hara icon "${name}" requires a label`);
---
<svg
  class:list={["hara-icon", className]}
  width={size}
  height={size}
  style={`width:${size}px;height:${size}px`}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={decorative ? undefined : "img"}
  aria-hidden={decorative ? "true" : undefined}
  aria-label={decorative ? undefined : label}
  focusable="false"
  data-hara-icon={name}
  data-category={definition.category}
  data-directional={definition.directional ? "true" : "false"}
>
  {definition.paths.map((d) => <path d={d} vector-effect="non-scaling-stroke" />)}
  {definition.circles.map((circle) => (
    <circle cx={circle.cx} cy={circle.cy} r={circle.r} vector-effect="non-scaling-stroke" />
  ))}
  {definition.rects.map((rect) => (
    <rect
      x={rect.x}
      y={rect.y}
      width={rect.width}
      height={rect.height}
      rx={rect.rx ?? 0}
      vector-effect="non-scaling-stroke"
    />
  ))}
</svg>
